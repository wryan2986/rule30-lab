  "source_text": "import datetime,hashlib,json,os,pathlib,platform,resource,signal,subprocess,sys,tempfile,time\nROOT=pathlib.Path('/home/ryan/rule30-lab');OUT=pathlib.Path('/tmp/astra_suffix_kernel_probe.json')\nSTART=time.monotonic();resource.setrlimit(resource.RLIMIT_AS,(1<<30,1<<30));resource.setrlimit(resource.RLIMIT_CPU,(120,120));signal.alarm(120)\naff=sorted(os.sched_getaffinity(0));os.sched_setaffinity(0,{aff[0]})\ndef canon(x):return json.dumps(x,sort_keys=True,separators=(',',':')).encode()\ndef sha(x):return hashlib.sha256(x).hexdigest()\ndef T(x):\n    bits=[(x>>j)&1 for j in range(x.bit_length()+2)]\n    return sum((bits[j]^((bits[j-1] if j>=1 else 0)|(bits[j-2] if j>=2 else 0)))<<j for j in range(len(bits)))\ndef A(x):return T(x)>>2\ndef G(g,x):return T(x) if g=='t' else T(x)^1 if g=='u' else T(2*x+1)>>1\ndef gate(x):return 'u' if x%16==7 else 't' if x%16==11 else None\ndef orbit(x,word):\n    states=[x]\n    for g in word:\n        assert gate(x)==g;x=G(g,G('p',x>>2));states.append(x)\n    return states\ndef admissible(w):return not any(b in w for b in ['uu','ttttt','ututtu'])\ndef omega(x,g):return int((x%16==0 and g=='t') or (x%16==1 and g=='u'))\nS='tupp';CAP=10\nlevels=[{'length':1,'modulus':16,'rows':[{'word':'t','representative':11},{'word':'u','representative':7}]}]\nparents=[('t',11),('u',7)];trials=[];witness=None\nfor length in range(2,CAP+1):\n    oldmod=1<<(2*(length-1)+2);rows=[];children=[]\n    for prefix,q in parents:\n        branches={}\n        for j in range(4):\n            v=q+j*oldmod;past=orbit(v,prefix);g=gate(past[-1])\n            trials.append([prefix,q,j,v,g])\n            if g:\n                assert g not in branches;branches[g]=v\n        assert set(branches)=={'t','u'}\n        for g in 'tu':\n            word=prefix+g;v=branches[g]\n            if not admissible(word):continue\n            states=orbit(v,word);age=length-1;a=v\n            for _ in range(age):a=A(a)\n            if age==1:ell=word[0]\n            else:\n                y=states[1]\n                for _ in range(age-2):y=A(y)\n                ell=S[y%4]\n            cost=omega(a,ell)\n            row={'word':word,'representative':v,'states':states,'age':age,'oldest_old_prefix_mod16':a%16,'oldest_letter':ell,'oldest_cost':cost}\n            rows.append(row);children.append((word,v))\n    rows.sort(key=lambda r:tuple('tu'.index(c) for c in r['word']))\n    levels.append({'length':length,'modulus':1<<(2*length+2),'rows':rows})\n    positives=[r for r in rows if r['oldest_cost']]\n    if positives:witness=positives[0];break\n    parents=children\nsummary={'completed':True,'failures':[],'declared_max_observed_length':CAP,'last_completed_length':levels[-1]['length'],\n 'levels':levels,'lift_trials':trials,'level_counts':{str(x['length']):len(x['rows']) for x in levels},'first_positive_oldest_term':witness,\n 'stopping_rule':'Complete each admissible length in order; stop at first positive oldest-born cost or length10.'}\nsource=pathlib.Path(__file__).read_bytes();inputs={p:sha((ROOT/p).read_bytes()) for p in ['proofs/informal/problem1_prescribed_history_cost_pullback.md','proofs/informal/problem1_zero_cost_return_language.md']}\nrecord={'experiment_id':'problem1-suffix-kernel-cylinder-probe-20260905','timestamp_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n 'git_commit':subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip(),'question':'problem1',\n 'hypothesis':'Every aged born letter has W* cost0 when its following forced step exists and the full observed branch prefix is admissible.',\n 'backend':'python-cell-rule-branch-cylinder-lifting','parameters':{'maximum_observed_length':CAP,'minimum_tested_length':2,'word_order':'length then t,u lexicographic','forbidden_factors':['uu','ttttt','ututtu'],'cpu_seconds_limit':120,'wall_seconds_limit':120,'address_space_bytes':1<<30},\n 'hardware':{'machine':platform.machine(),'cpu_count':os.cpu_count(),'affinity_used':sorted(os.sched_