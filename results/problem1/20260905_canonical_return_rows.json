  "source_text": "\"\"\"Admission: canonicalize the 19 existing full-domain labeled occurrences.\n\nNo frontier search. A missing canonical representative or changed cylinder\ncertificate falsifies the proposed reduction in this finite box. 120s, 1 GiB.\n\"\"\"\nimport datetime\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport resource\nimport signal\nimport subprocess\nimport tempfile\nimport time\nimport sys\n\nstart=time.monotonic()\nroot=Path('/home/ryan/rule30-lab')\nresource.setrlimit(resource.RLIMIT_AS,(1024**3,1024**3))\ndef timeout(*args): raise TimeoutError('120-second cap')\nsignal.signal(signal.SIGALRM,timeout);signal.alarm(120)\npath=root/'results/problem1/20260905_three_return_signed_mass.json'\nrows=json.loads(path.read_text())['result']['occurrences']\nassert len(rows)==19\ndef key(row):\n    return (row['phase'],row['complexity'],row['state_hex'],row['cut'],*row['gaps'])\nlookup={key(row):row for row in rows}\nassert len(lookup)==19\nchanged=[]\nfor row in rows:\n    k=key(row)\n    canonical=lookup[k[:-1]+(2,)]\n    for field in ('phase','complexity','state_hex','cut','depth',\n                  'signed_mass','dominant_shadows','same_cylinder','defect_histogram'):\n        assert row[field]==canonical[field],(k,field)\n    if row['gaps'][-1]!=2:\n        changed.append({'original':list(k),'canonical':list(key(canonical))})\nrepresentatives=[row for row in rows if row['gaps'][-1]==2]\nassert len(representatives)==17\nassert len({key(row)[:4] for row in rows})==17\nsummary={'source_labeled_occurrences':19,'canonical_representatives':17,\n         'distinct_cylinders':17,'changed_labels':changed,\n         'all_certificates_preserved':True,'source_rows':rows}\nsha=lambda data:hashlib.sha256(data).hexdigest()\nsource=Path(__file__).read_text()\ncpu=next(line.split(':',1)[1].strip() for line in Path('/proc/cpuinfo').read_text().splitlines()\n         if line.startswith('model name'))\nrecord={'experiment_id':'20260905_canonical_return_rows',\n        'timestamp_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n        'git_commit':subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),\n        'question':'problem1','hypothesis':'Every stored full-domain occurrence has a same-cylinder canonical last-gap-two representative with the identical certificate.',\n        'backend':'fixed-record-canonical-key-comparison',\n        'parameters':{'phase':['p','u'],'source_max_k':16,'source_rows':19,\n                      'wall_limit_seconds':120,'address_space_bytes':1024**3},\n        'hardware':{'cpu_model':cpu,'machine':platform.machine()},\n        'software':{'python':sys.version,'platform':platform.platform()},\n        'runtime_seconds':time.monotonic()-start,'source_text':source,\n        'result_hashes':{'source_sha256':sha(source.encode()),\n            'result_sha256':sha(json.dumps(summary,sort_keys=True,separators=(',',':')).encode()),\n            'input_record_sha256':sha(path.read_bytes())},\n        'result_summary':summary,'status':'finite-exhaustive',\n        'proof_scope':'All 19 stored labeled occurrences only; no new frontier computation.',\n        'interpretation':'The 19 old labels reduce to 17 unchanged base cylinders in this box; the all-depth proof requires the word argument.',\n        'limitations':['Original input record was pre-existing and untracked; all used rows are embedded here.',\n                       'No all-depth boundary exclusion or signed-nonvanishing claim.']}\ndest=root/'results/problem1/20260905_canonical_return_rows.json'\nfd,tmp=tempfile.mkstemp(dir=dest.parent,prefix=dest.name+'.',suffix='.tmp')\nwith os.fdopen(fd,'w') as f:\n    json.dump(record,f,indent=2,sort_keys=True);f.write('\\n');f.flush();os.fsync(f.fileno())\nos.replace(tmp,dest);signal.alarm(0)\nprint('19 labels -> 17 canonical representatives, preserving all cylinder certificates.')\nprint(changed)\n",
