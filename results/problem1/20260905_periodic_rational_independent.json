  "source_text": "\"\"\"Independent vector-window verification for four named periodic schedules.\"\"\"\nimport hashlib,json,os,platform,resource,subprocess,tempfile,time\nfrom datetime import datetime,timezone\nfrom pathlib import Path\nROOT=Path(os.environ.get('RULE30_REPLAY_ROOT',Path.cwd())).resolve()\nOUT=Path(os.environ.get('RULE30_REPLAY_OUTPUT','/tmp/rule30_periodic_rational_independent.json'))\nWORDS=('t','u','ututtt','ttututt')\nCAP=1<<20\nSECONDS=120\ndef sha(b): return hashlib.sha256(b).hexdigest()\ndef rotate(v,p): return (v>>1)|((v&1)<<(p-1))\ndef nextv(a,b,c,d,p):\n    return rotate(c,p) ^ (d|c) ^ ((d^(c|b)) | (c^(b|a)))\ndef gen_cell(bits,name):\n    # Independent direct local Boolean rule, with explicit low boundary.\n    out=[x ^ ((bits[n-1] if n else 0) | (bits[n-2] if n>=2 else 0)) for n,x in enumerate(bits)]\n    if name=='u': out[0]^=1\n    if name=='p':\n        out[0]^=1\n        if len(out)>1: out[1]^=1-bits[0]\n    return out\ndef getbit(vs,a,lam,j,n):\n    if n>=len(vs): n=a+(n-a)%lam\n    return (vs[n]>>j)&1\ndef one(word,start):\n    p=len(word);ones=(1<<p)-1;delta=sum((c=='u')<<j for j,c in enumerate(word))\n    vs=[ones,ones,delta,ones^delta,rotate(delta,p),ones^delta]\n    seen={};step=0\n    while True:\n        if time.monotonic()-start>SECONDS: return {'word':word,'completed':False,'reason':'120-second cap'}\n        state=tuple(vs[-4:])\n        if state in seen:\n            mu=seen[state];lam=step-mu;break\n        if step>=CAP: return {'word':word,'completed':False,'reason':'2^20 state cap','states_checked':step}\n        seen[state]=step\n        vs.append(nextv(*state,p));step+=1\n    a=mu+2\n    assert tuple(vs[2+mu:6+mu])==tuple(vs[2+mu+lam:6+mu+lam])\n    # All exact phase equations: beyond a+2 both sides are lambda-periodic.\n    horizon=max(4,a+2)+lam\n    phase_checks=0\n    for j,c in enumerate(word):\n        z=[getbit(vs,a,lam,j,n+2) for n in range(horizon)]\n        got=gen_cell(gen_cell(z,'p'),c)\n        expected=[getbit(vs,a,lam,(j+1)%p,n) for n in range(horizon)]\n        assert got==expected\n        phase_checks+=horizon\n    rationals=[]\n    for j in range(p):\n        A=sum(((vs[n]>>j)&1)<<n for n in range(a))\n        C=sum(((vs[a+n]>>j)&1)<<n for n in range(lam))\n        den=1-(1<<lam);num=A*den+(C<<a)\n        from fractions import Fraction\n        f=Fraction(num,den)\n        rationals.append({'phase':j,'prefix_hex':hex(A),'period_block_hex':hex(C),'numerator_hex':hex(f.numerator),'denominator_hex':hex(f.denominator)})\n    if word=='t': assert rationals[0]['numerator_hex']=='0x1' and rationals[0]['denominator_hex']=='0x3'\n    if word=='u': assert rationals[0]['numerator_hex']=='0x5' and rationals[0]['denominator_hex']=='0x3'\n    return {'word':word,'completed':True,'mu':mu,'lambda':lam,'spatial_start':a,'distinct_window_states':step,'vectors':vs,'phase_equation_bit_checks':phase_checks,'phase_equation_horizon':horizon,'rationals':rationals}\ndef main():\n    start=time.monotonic();resource.setrlimit(resource.RLIMIT_AS,(1<<30,1<<30))\n    rows=[one(w,start) for w in WORDS]\n    summary={'completed':all(r['completed'] for r in rows),'rows':rows,'validation_failures':[]}\n    source=Path(__file__).read_text()\n    rec={'experiment_id':'problem1-periodic-rational-independent-20260905','timestamp_utc':datetime.now(timezone.utc).isoformat(),'git_commit':subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip(),'question':'problem1','hypothesis':'Four named periodic auxiliary schedules admit the stated exact cyclic-phase spatial recurrence and sufficient-state cycle certificates.','backend':'Python vector recurrence and cell-array phase-equation verification','parameters':{'words':WORDS,'state_cap_per_word':CAP,'wall_seconds':SECONDS,'memory_bytes':1<<30,'local_cpus':1,'no_frontier_enumeration':True,'no_truncation_search_in_this_replay':True},'hardware':{'machine':platform.machine(),'processor':platform.processor(),'cpu_count':os.cpu_count(),'peak_rss_kib':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss},'software':{'python':platform.python_version(),'platform':platform.platform()},'runtime_seconds':time.monotonic()-start,'source_text':source,'result_summary':summary,'status':'finite-exhaustive' if summary['completed'] else 'inconclusive','proof_scope':'Every transition through closure and a complete eventually periodic phase-equation check for each completed named cycle; the general theorem is proved separately.','interpretation':'Sufficient-state repetition certifies spatial periodicity. No assertion that the actual fringe schedule is periodic.','limitations':['Only the four named schedule words; no frontier or new occurrence census.','A cycle period is not asserted minimal for each phase.','No bit-length-bound conclusion is inferred from this replay.']}\n    rec['result_hashes']={'source_sha256':sha(source.encode()),'result_sha256':sha(json.dumps(summary,sort_keys=True,separators=(',',':')).encode())}\n    OUT.parent.mkdir(parents=True,exist_ok=True)\n    fd,tmp=tempfile.mkstemp(dir=OUT.parent,prefix=OUT.name+'.',suffix='.tmp')\n    with os.fdopen(fd,'w') as f:\n        json.dump(rec,f,indent=2,sort_keys=True);f.write('\\n');f.flush();os.fsync(f.fileno())\n    os.replace(tmp,OUT)\n    print(json.dumps({'output':str(OUT),'completed':summary['completed'],'rows':[{k:v for k,v in r.items() if k not in ('vectors','rationals')} for r in rows]},sort_keys=True))\nif __name__=='__main__':main()\n",
